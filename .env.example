# ─── Server & Environment ─────────────────────────────────────────
# Public hostname served by Caddy (automatic HTTPS).
# Example: If your VM IP is 123.45.67.89 -> SERVER_HOSTNAME=123-45-67-89.nip.io
SERVER_HOSTNAME=localhost
ENVIRONMENT=production

# ─── Branding ─────────────────────────────────────────────────────
APP_NAME=Shared Album
APP_VERSION=1.0.0

# ─── Security ─────────────────────────────────────────────────────
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars

# ─── Access Control ───────────────────────────────────────────────
# Comma-separated admin emails (get the admin role on first sign-in).
ADMIN_EMAILS=you@example.com
# Optional: restrict sign-in to specific email domains. Empty = any Google account.
# Example: ALLOWED_EMAIL_DOMAINS=example.com,club.org
ALLOWED_EMAIL_DOMAINS=

# ─── Google OAuth (from Google Cloud Console) ─────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Storage ──────────────────────────────────────────────────────
# "local" = disk only. "gdrive" = also mirror originals to Google Drive.
STORAGE_BACKEND=local
STORAGE_BASE_PATH=./uploads
# Optional Google Drive mirror (needs a service-account key):
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id
GDRIVE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "..."}'

# ─── Upload Limits ────────────────────────────────────────────────
MAX_IMAGE_SIZE_BYTES=52428800
MAX_VIDEO_SIZE_BYTES=2147483648
MAX_UPLOAD_SIZE_MB=2048

# ─── Time Capsule ─────────────────────────────────────────────────
# Reveal date (YYYY-MM-DD). Entries are accepted until this date.
TIME_CAPSULE_REVEAL_DATE=2027-05-15

# ─── Contact (shown in the footer) ────────────────────────────────
ADMIN_EMAIL=curators@example.com
ADMIN_WHATSAPP_URL=

# ─── Frontend ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# VITE_API_URL=https://your-hostname/api/v1
